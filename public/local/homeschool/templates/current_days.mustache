{{!
    @template local_homeschool/current_days

    Currently-on day picker block for each child.

    @copyright 2026 Sarah
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
{{#hascurrentdays}}
    <div class="local-homeschool-current-days mb-3">
        <div class="form-label">{{#str}} currentlyonheading, local_homeschool {{/str}}</div>
        {{#currentnone}}
            <p class="mb-0">{{#str}} currentdaynone, local_homeschool {{/str}}</p>
        {{/currentnone}}
        {{#currentsameday}}
            <p class="mb-0">
                <a href="{{samedayurl}}">{{samedaylabel}}</a>
            </p>
        {{/currentsameday}}
        {{#currentchildren}}
            {{#haswork}}
                <div class="local-homeschool-current-day-child">
                    {{name}} — <a href="{{url}}">{{daylabel}}</a>
                </div>
            {{/haswork}}
            {{^haswork}}
                <div class="local-homeschool-current-day-child">
                    {{name}} — {{#str}} currentdaynone, local_homeschool {{/str}}
                </div>
            {{/haswork}}
        {{/currentchildren}}
    </div>
{{/hascurrentdays}}
